{
  "manifest_version": 3,
  "name": "Chrome Runtime Investigator",
  "description": "Investigate runtime failures in DevTools using evidence-backed local analysis.",
  "version": "0.1.0",
  "devtools_page": "devtools.html",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
